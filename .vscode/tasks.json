{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build and Run C++ (MinGW, C++23)",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/C",
                "g++ -std=c++23 -Wall -O2 -g \"${file}\" -o \"${fileDirname}\\${fileBasenameNoExtension}.exe\" && \"${fileDirname}\\${fileBasenameNoExtension}.exe\""
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file (C++23)",
            "command": "D:\\Program Files\\mingw64\\bin\\g++.exe",
            "args": [
                "-std=c++23",
                "-Wall",
                "-O2",
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Task generated by Debugger (C++23)."
        }
    ]
}
