{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build and Run C++ (MinGW)",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/C",
                "g++ -g \"${file}\" -o \"${fileDirname}\\${fileBasenameNoExtension}.exe\" && \"${fileDirname}\\${fileBasenameNoExtension}.exe\""
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
